# Ameer Perfumes ERP — Hostinger Subdomain Isolation & Security Rules
Options -Indexes

# Forward Authorization header cleanly on Hostinger Apache/LiteSpeed PHP
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Block direct HTTP access to sensitive configuration, SQL schema, and SQLite backup files
<FilesMatch "^(config\.php|config\.example\.php|db\.php|mysql_schema\.sql|HOSTINGER_CLOUD_SETUP_GUIDE\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(db|db-wal|db-shm|sql|log|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^backups/ - [F,L]

    # Route /api/v1/* requests cleanly to api.php while preserving Authorization header
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    RewriteRule ^api/v1/(.*)$ api.php?route=$1 [QSA,L]
</IfModule>

